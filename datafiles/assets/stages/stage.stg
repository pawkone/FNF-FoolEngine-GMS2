stageObject_setDepth("stagefront",0)
stageObject_setDepth("stagecurtains",-200)
stageObject_setScroll("stageback",0.9,0.9)
stageObject_setScroll("stagefront",0.9,0.9)
stageObject_setScroll("stagecurtains",1.3,1.3)