stageGlobal_setDefaultZoom(1)
stageGlobal_setDefaultColour(c_black)
stageObject_char(900, 400, "bf")
stageObject_char(700, 430, "gf")
stageObject_char(600, 400, "dad")
stageObject_create("stageback", -600, -200, "back")
stageObject_create("stagefront", -600, 600, "front")
stageObject_create("stagecurtains", -500, -300, "curtains")
